# Runtime
NODE_ENV=development
PORT=8090
LOG_LEVEL=info
# LOG_FORMAT=json   # production structured logs (default: pretty in dev)

# Database (optional — default <repo-root>/data/keenai.db; relative paths are repo-root relative)
# DATABASE_URL=file:./data/keenai.db

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long-please
# Widget HMAC (optional — defaults to JWT_SECRET; run `pnpm seed` to print demo userHash)
# WIDGET_HMAC_SECRET=change-me-widget-hmac-secret-32chars-min

# Custom Action secrets (vault:extend-trial-hmac -> CUSTOM_ACTION_SECRET_EXTEND_TRIAL_HMAC)
# CUSTOM_ACTION_SECRET_EXTEND_TRIAL_HMAC=change-me-action-hmac-secret

JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
APP_URL=http://localhost:3000
# Public HTTPS API origin used for provider webhook registration.
# CHANNEL_WEBHOOK_BASE_URL=https://api.example.com

# Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8090

# Slack OAuth installation (callback URL must match the Slack app configuration)
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_SIGNING_SECRET=...
# SLACK_OAUTH_REDIRECT_URI=http://localhost:8090/api/v1/dashboard/channel-connections/slack/oauth/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_OAUTH_REDIRECT_URI=http://localhost:8090/api/v1/dashboard/channel-connections/discord/oauth/callback
# Optional override. Defaults to the minimal permissions required for declared Discord capabilities.
# DISCORD_BOT_PERMISSIONS=274878024768
# Feishu marketplace app (ISV) installation and tenant authorization
# FEISHU_ISV_APP_ID=
# FEISHU_ISV_APP_SECRET=
# FEISHU_ISV_VERIFICATION_TOKEN=
# FEISHU_ISV_ENCRYPT_KEY=
# FEISHU_ISV_OAUTH_REDIRECT_URI=http://localhost:8090/api/v1/dashboard/channel-connections/feishu/oauth/callback
# DingTalk marketplace app (App-Only administrator consent)
# DINGTALK_ISV_SUITE_KEY=
# DINGTALK_ISV_SUITE_SECRET=
# DINGTALK_ISV_CALLBACK_TOKEN=
# DINGTALK_ISV_ENCODING_AES_KEY=
# DINGTALK_ISV_OAUTH_REDIRECT_URI=http://localhost:8090/api/v1/dashboard/channel-connections/dingtalk/oauth/callback
# WeCom service-provider suite installation
# WECOM_SUITE_ID=
# WECOM_SUITE_SECRET=
# WECOM_SUITE_TOKEN=
# WECOM_SUITE_ENCODING_AES_KEY=
# WECOM_SUITE_OAUTH_REDIRECT_URI=http://localhost:8090/api/v1/dashboard/channel-connections/wecom/oauth/callback
# EMAIL_GOOGLE_CLIENT_ID=...
# EMAIL_GOOGLE_CLIENT_SECRET=...
# EMAIL_MICROSOFT_CLIENT_ID=...
# EMAIL_MICROSOFT_CLIENT_SECRET=...
# EMAIL_OAUTH_REDIRECT_URI=http://localhost:8090/api/v1/dashboard/channel-connections/email/oauth/callback
# Meta WhatsApp Embedded Signup (configure the app webhook with WHATSAPP_VERIFY_TOKEN)
# META_APP_ID=...
# META_APP_SECRET=...
# META_EMBEDDED_SIGNUP_CONFIG_ID=...
# WHATSAPP_VERIFY_TOKEN=...
# WHATSAPP_GRAPH_API_VERSION=v20.0

# Local file uploads (optional — default `<repo>/data/uploads`)
# UPLOAD_DIR=./data/uploads
# UPLOAD_MAX_BYTES=10485760

# Knowledge base parsing (optional)
# KEENAI_KB_DOCUMENT_PARSER=anydoc        # anydoc | http | cloud
# KEENAI_KB_DOCUMENT_PARSER_URL=http://127.0.0.1:8095/parse
# KEENAI_KB_DOCUMENT_PARSER_ENGINE=docling
# KEENAI_KB_URL_PARSER=firecrawl          # firecrawl | crawl4ai; unset uses built-in shallow fetch
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# CRAWL4AI_URL=http://127.0.0.1:11235
# CRAWL4AI_API_TOKEN=...

# KB eval judge (optional — enables @mastra/evals faithfulness in golden suite)
# KEENAI_EVAL_JUDGE_MODEL=openai/gpt-4o-mini

# Copilot / LLM (optional — without key, stub provider is used)
# LLM_PROVIDER=gemini           # stub | openai | anthropic | deepseek | kimi | qwen | zhipu | gemini | ollama
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# STT_PROVIDER=stub              # stub | openai (auto: openai when OPENAI_API_KEY set)
# OPENAI_WHISPER_MODEL=whisper-1
# THUMBNAIL_PROVIDER=stub        # stub | ffmpeg
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# DEEPSEEK_API_KEY=sk-...
# # DEEPSEEK_MODEL=deepseek-v4-flash
# KIMI_API_KEY=sk-...
# KIMI_MODEL=moonshot-v1-8k
# QWEN_API_KEY=sk-...
# QWEN_MODEL=qwen-plus
# ZHIPU_API_KEY=sk-...
# ZHIPU_MODEL=glm-4-flash
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Workflow engine (optional — default sync; set INNGEST_EVENT_KEY for Inngest)
# INNGEST_EVENT_KEY=
# INNGEST_APP_ID=keenai
# INNGEST_SCAN_CRON=*/5 * * * *
# INNGEST_AGENT_RECOVERY_CRON=*/5 * * * *
# INNGEST_AGENT_AUTO_CLOSE_CRON=* * * * *
# AGENT_AUTO_CLOSE_SCAN_INTERVAL_SECONDS=30
# AGENT_RECOVERY_INTERVAL_MINUTES=5
# AGENT_TOOL_STALE_SECONDS=300
# WORKFLOW_SCAN_INTERVAL_MINUTES=0   # sync-mode background scan (Docker lite sets 5)

# Email IMAP connections are configured in Dashboard > Settings > Integrations.
# This only controls the fallback scheduler when Inngest is disabled (0 disables it).
# EMAIL_IMAP_POLL_INTERVAL_MINUTES=5
# EMAIL_IMAP_MAX_MESSAGE_BYTES=31457280
# INNGEST_IMAP_POLL_CRON=*/5 * * * *

# Customer portal (public ticket read — default on outside production)
# PORTAL_PUBLIC_READ=true
# PORTAL_APP_URL=http://localhost:3002
# NEXT_PUBLIC_PORTAL_URL=http://localhost:3002
# NEXT_PUBLIC_PORTAL_ORG_SLUG=demo

# Magic link email (optional — dev logs link to console)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=noreply@keenai.local
